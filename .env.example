# Copy to .env and edit. docker-compose reads this file.
ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-before-deploying
DATABASE_URL=postgresql+psycopg://dishari:dishari@db:5432/dishari

# Frontend (Arshi): add the dev server / deployed URL here, comma separated
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ML (Razzaque): "mock" until the real model is ready, then e.g. dishari_ml.tagger:Tagger
TAGGER_IMPL=mock
MODEL_PATH=/app/ml_models/current
REVIEW_THRESHOLD=0.60
BOARD_MATCH_THRESHOLD=0.85
MAX_BATCH=500

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
SEED_ON_STARTUP=true
SEED_DEMO_USERS=true
DEMO_PASSWORD=Dishari@123
PRACTICE_ALLOW_NEEDS_REVIEW=true
